<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Guide" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/text" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Setup, permissions and how it all works"
            android:textColor="@color/text_secondary" android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PERMISSIONS" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <LinearLayout android:id="@+id/perm_list"
            android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SETUP GUIDE" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:letterSpacing="0.08"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/guide_text"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:lineSpacingExtra="6dp"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>
